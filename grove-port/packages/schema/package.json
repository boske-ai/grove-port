{
  "name": "@grove-port/schema",
  "version": "0.1.0",
  "description": "Grove Port v1 Zod schemas and JSON Schema exports",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "emit-json-schema": "bun run scripts/emit-json-schema.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.24.6"
  }
}
