{
  "name": "@grove-port/schema",
  "version": "0.2.0",
  "description": "Grove Port v1 Zod schemas and JSON Schema exports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boske-ai/grove-port.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/boske-ai/grove-port/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/boske-ai/grove-port/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs schema",
    "emit-json-schema": "bun run scripts/emit-json-schema.ts"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.24.6"
  },
  "module": "./dist/index.js"
}
